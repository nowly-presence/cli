{
  "name": "@nowly/cli",
  "version": "1.8.0",
  "description": "Nowly command-line tools to scaffold, build, validate, package and test website presences.",
  "homepage": "https://docs.nowly.me",
  "repository": {
    "type": "git",
    "url": "https://github.com/nowly-presence/cli.git"
  },
  "bugs": {
    "url": "https://github.com/nowly-presence/cli/issues"
  },
  "license": "MIT",
  "contributors": [
    {
      "name": "Gaëtan H",
      "url": "https://github.com/Steellgold"
    },
    {
      "name": "Anthony (KiMi)",
      "url": "https://github.com/q-kimi"
    }
  ],
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "bin": {
    "nowly": "./bin/cli.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "prepare": "simple-git-hooks",
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "coverage": "vitest run --coverage",
    "prepack": "pnpm build"
  },
  "simple-git-hooks": {
    "commit-msg": "node scripts/validate-commit-message.ts \"$1\""
  },
  "dependencies": {
    "@nowly/sdk": "^1.6.0",
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "dotenv": "^18.0.9",
    "enquirer": "^2.4.1",
    "esbuild": "0.28.2",
    "ora": "^9.4.1"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@vitest/coverage-v8": "4.1.9",
    "simple-git-hooks": "^2.14.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.13",
    "typescript": "7.0.2",
    "vitest": "4.1.9"
  }
}
